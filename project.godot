; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CoilClash"
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
ConsentManager="*res://scripts/autoload/consent_manager.gd"
RemoteConfig="*res://scripts/autoload/remote_config.gd"
Analytics="*res://scripts/autoload/analytics.gd"
AdManager="*res://scripts/autoload/ad_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
ObjectPoolRegistry="*res://scripts/autoload/object_pool_registry.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
UIManager="*res://scripts/autoload/ui_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

